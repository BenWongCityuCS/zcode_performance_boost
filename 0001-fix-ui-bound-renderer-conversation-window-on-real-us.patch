+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ConversationRow, ConversationSnapshot } from "@zcode/shared/zcode-protocol-v4";
+import {
+  CONVERSATION_WINDOW_MAX_QUERY_TURNS,
+  boundWindowOnRealUserQuery,
+  isRealUserQueryRow,
+  mergeSnapshotTailOntoLocalWindow,
+} from "../src/v4/conversationWindowBound.js";
+
+function row(rowId: number, turnId: string, kind: string, origin?: string): ConversationRow {
+  return {
+    rowId,
+    turnId,
+    kind,
+    ...(origin === undefined ? {} : { origin }),
+    createdAt: 0,
+    createdAtSeq: rowId,
+  } as unknown as ConversationRow;
+}
+
+const query = (rowId: number, turnId: string): ConversationRow =>
+  row(rowId, turnId, "userInput", "realUser");
+const synthetic = (rowId: number, turnId: string): ConversationRow =>
+  row(rowId, turnId, "userInput", "goalContinuation");
+const tool = (rowId: number, turnId: string): ConversationRow => row(rowId, turnId, "toolCall");
+
+function snapshot(
+  rows: ConversationRow[],
+  totalCount: number,
+  firstRowId: number | null,
+  logEpoch = "e1",
+): ConversationSnapshot {
+  return {
+    logEpoch,
+    rows: { window: rows, totalCount, firstRowId },
+  } as unknown as ConversationSnapshot;
+}
+
+test("isRealUserQueryRow 只认 realUser 的 userInput", () => {
+  assert.equal(isRealUserQueryRow(query(1, "t1")), true);
+  assert.equal(isRealUserQueryRow(synthetic(2, "t1")), false);
+  assert.equal(isRealUserQueryRow(tool(3, "t1")), false);
+});
+
+test("真实提问不超过 N 时窗口恒等不变", () => {
+  const rows: ConversationRow[] = [];
+  for (let i = 0; i < CONVERSATION_WINDOW_MAX_QUERY_TURNS; i += 1) {
+    rows.push(query(i * 2 + 1, `t${i}`), tool(i * 2 + 2, `t${i}`));
+  }
+  assert.equal(boundWindowOnRealUserQuery(rows), rows);
+});
+
+test("第 N+1 个提问把窗口收敛到最近 N 个提问所在的回合", () => {
+  const rows: ConversationRow[] = [];
+  const turns = CONVERSATION_WINDOW_MAX_QUERY_TURNS + 1;
+  for (let i = 0; i < turns; i += 1) {
+    rows.push(query(i * 3 + 1, `t${i}`), tool(i * 3 + 2, `t${i}`), tool(i * 3 + 3, `t${i}`));
+  }
+  // 无真实提问的合成回合：收敛时一并出窗。
+  rows.push(synthetic(100, "t-synthetic"));
+  const bounded = boundWindowOnRealUserQuery(rows);
+  assert.notEqual(bounded, rows);
+  assert.equal(bounded.length, CONVERSATION_WINDOW_MAX_QUERY_TURNS * 3);
+  assert.equal(bounded[0]?.rowId, 4); // t1 的首行；t0 整回合已出窗
+  assert.equal(bounded.some((r) => r.turnId === "t0"), false);
+  assert.equal(bounded.some((r) => r.turnId === "t-synthetic"), false);
+  assert.equal(bounded.some((r) => r.turnId === `t${turns - 1}`), true);
+});
+
+test("合成行不计入提问数、不触发收敛", () => {
+  const rows: ConversationRow[] = [query(1, "t0"), query(2, "t1"), query(3, "t2")];
+  for (let i = 0; i < 30; i += 1) rows.push(synthetic(10 + i, `t-syn-${i}`));
+  assert.equal(boundWindowOnRealUserQuery(rows), rows);
+});
+
+test("merge：同 logEpoch 且追加性成立时把本地更早行拼回尾巴前", () => {
+  const prev = snapshot(
+    Array.from({ length: 10 }, (_, i) => tool(i + 1, `t${i}`)),
+    20,
+    1,
+  );
+  const next = snapshot(
+    Array.from({ length: 4 }, (_, i) => tool(i + 9, `t${i + 8}`)),
+    20,
+    1,
+  );
+  const merged = mergeSnapshotTailOntoLocalWindow(prev, next);
+  assert.notEqual(merged, next);
+  assert.equal(merged.rows.window.length, 12);
+  assert.equal(merged.rows.window[0]?.rowId, 1);
+  assert.equal(merged.rows.window[11]?.rowId, 12);
+  assert.equal(merged.rows.totalCount, 20);
+});
+
+test("merge：logEpoch 不同 / 无本地状态时整取新快照", () => {
+  const prev = snapshot([tool(1, "t0")], 10, 1, "e1");
+  const next = snapshot([tool(2, "t0")], 10, 1, "e2");
+  assert.equal(mergeSnapshotTailOntoLocalWindow(prev, next), next);
+  assert.equal(mergeSnapshotTailOntoLocalWindow(null, next), next);
+});
+
+test("merge：追加性被破坏（rewind 迹象）时放弃拼接", () => {
+  const prev = snapshot([tool(10, "t0"), tool(11, "t0")], 20, 1);
+  // totalCount 倒退
+  const rewoundTotal = snapshot([tool(12, "t0")], 19, 1);
+  assert.equal(mergeSnapshotTailOntoLocalWindow(prev, rewoundTotal), rewoundTotal);
+  // 末行 rowId 倒退
+  const rewoundTail = snapshot([tool(5, "t0")], 20, 1);
+  assert.equal(mergeSnapshotTailOntoLocalWindow(prev, rewoundTail), rewoundTail);
+});
+
+test("merge：拼回行数超过快照声称的更早行数上限时放弃拼接", () => {
+  // 本地窗口 15 行（rowId 1..15，total 15）；新尾巴 2 行（15..16）、total 15 不变
+  // （rewind 后 rowId 有空洞是合法的）⇒ 声称的更早行只有 15-2=13 行，本地可拼回 14 行 → 放弃。
+  const prev = snapshot(
+    Array.from({ length: 15 }, (_, i) => tool(i + 1, `t${i}`)),
+    15,
+    1,
+  );
+  const next = snapshot([tool(15, "t14"), tool(16, "t14")], 15, 1);
+  assert.equal(mergeSnapshotTailOntoLocalWindow(prev, next), next);
+});
