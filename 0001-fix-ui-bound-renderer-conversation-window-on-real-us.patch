diff --git a/packages/ui/src/v4/conversationWindowBound.ts b/packages/ui/src/v4/conversationWindowBound.ts
new file mode 100644
index 0000000..476a0f0
--- /dev/null
+++ b/packages/ui/src/v4/conversationWindowBound.ts
@@ -0,0 +1,81 @@
+// 会话显示窗口收敛（display-window bounding）。
+//
+// rows.window 在协议层只增不减（apply.ts 的 row.appended 追加后无淘汰），叠加问题导航
+// 宽屏自动 loadAllOlder 全量补齐，渲染进程持有的行随会话时长无限增长；超长会话下界面
+// 明显卡顿（ZCode Desktop 3.14.x 实测，i5-12400/64GB 机器上不打补丁超长对话轮即卡）。
+// 这里收敛的只是**客户端显示窗口**：完整历史仍在服务端 projection（rowsRange 分页随时
+// 取回），协议层 apply.ts 与服务端投影不动。
+//
+// 语义来自一整轮实测迭代（客户端窗口补丁 v1→v3.5）的结论：
+// 1. 只在「真人发新提问」（row.appended 且 kind=userInput/origin=realUser）时收敛。
+//    goalContinuation / backgroundResult / mailbox / synthetic 行同为 kind=userInput，
+//    若一并触发，单轮长回合里每次合成交达都会裁一轮——翻旧账会被反复打断；
+// 2. 按**提问数**留窗口而不是按行数：重工具回合里按行数裁会让窗口只剩 0/1 条提问；
+//    保留「最近 N 个真实提问所在的回合」（turn 是 row 上的标签，按 turnId 过滤即
+//    回合内已加载行整体保留，回合头不丢）；
+// 3. 恒等稳定：什么都没裁掉就还同一个数组引用，避免无谓的下游重渲染。
+//
+// 被收敛的行不是删除：canLoadOlder 判定（window 首行 rowId > firstRowId）继续成立，
+// 滚动到顶的 loadOlder 预取 / 手动加载更早照常把它们经 rowsRange 分页取回。
+import type { ConversationRow, ConversationSnapshot } from "@zcode/shared/zcode-protocol-v4";
+
+/** 窗口保留「最近多少个真实提问所在的回合」。 */
+export const CONVERSATION_WINDOW_MAX_QUERY_TURNS = 10;
+
+/** 真人新提问行：kind=userInput 且 origin=realUser（其余 origin 均为合成行）。 */
+export function isRealUserQueryRow(row: ConversationRow): boolean {
+  return row.kind === "userInput" && row.origin === "realUser";
+}
+
+/**
+ * 在窗口已含新行之后收敛：保留最近 CONVERSATION_WINDOW_MAX_QUERY_TURNS 个真实提问
+ * 所在回合的全部已加载行；什么都没裁掉就原样返回（恒等稳定）。入参不被修改。
+ *
+ * 注意合成回合（无真实提问的 turn）会随收敛一并出窗——它们没有翻阅价值，且
+ * rowsRange 仍可分页取回。
+ */
+export function boundWindowOnRealUserQuery(window: ConversationRow[]): ConversationRow[] {
+  const queries = window.filter(isRealUserQueryRow);
+  if (queries.length <= CONVERSATION_WINDOW_MAX_QUERY_TURNS) return window;
+  const keptTurnIds = new Set(
+    queries.slice(-CONVERSATION_WINDOW_MAX_QUERY_TURNS).map((row) => row.turnId),
+  );
+  const bounded = window.filter((row) => keptTurnIds.has(row.turnId));
+  return bounded.length === window.length ? window : bounded;
+}
+
+/**
+ * 快照尾巴拼接（守卫式尾拼；store 规则 1「整体替换」的唯一例外）。
+ *
+ * 快照的 rows.window 只带尾部 snapshotTailWindowRows 行（协议常量，60）。单轮长回合里
+ * 尾 60 行全是工具输出，任何一次重订阅（帧断档 → forceSnapshot）的整替都会把窗口里
+ * 早前的提问整段冲掉（实测症状：长回合把之前的提问「挤走」、界面反复刷新）。
+ * 在**同 logEpoch 且追加性未破坏**时，把本地窗口里 [firstRowId, 新尾巴首行) 的行拼回
+ * 前面；其余任何情况整取新快照（原行为）。
+ *
+ * 追加性守卫（任一不满足即放弃拼接）：
+ * - 新 totalCount / 新末行 rowId 不得小于本地（rewind 迹象 → 整取）；
+ * - 拼回行数不得超过 totalCount - 新尾巴长度（快照声称的更早行数上限）。
+ *
+ * 输出是单个全新快照对象、由调用方一次 setState 原子落地——不涉及逐键合并，
+ * 与 store「绝不 merge」的状态机规则不冲突（那条规则针对任意状态键）。
+ */
+export function mergeSnapshotTailOntoLocalWindow(
+  prev: ConversationSnapshot | null,
+  next: ConversationSnapshot,
+): ConversationSnapshot {
+  if (prev === null || next.logEpoch !== prev.logEpoch) return next;
+  const nextWindow = next.rows.window;
+  const prevWindow = prev.rows.window;
+  const nextFirst = nextWindow[0];
+  const nextLast = nextWindow[nextWindow.length - 1];
+  const prevLast = prevWindow[prevWindow.length - 1];
+  if (nextFirst === undefined || nextLast === undefined || prevLast === undefined) return next;
+  if (next.rows.totalCount < prev.rows.totalCount) return next;
+  if (nextLast.rowId < prevLast.rowId) return next;
+  const firstRowId = next.rows.firstRowId ?? Number.NEGATIVE_INFINITY;
+  const kept = prevWindow.filter((row) => row.rowId < nextFirst.rowId && row.rowId >= firstRowId);
+  if (kept.length === 0) return next;
+  if (kept.length > next.rows.totalCount - nextWindow.length) return next;
+  return { ...next, rows: { ...next.rows, window: [...kept, ...nextWindow] } };
+}
